PORT=3000
# Public URL of this site, used for gateway redirect URLs.
# Optional: defaults to the address the request came in on.
BASE_URL=

# Where invoices are stored. Required on Vercel; without these, local runs
# use data/orders.json. Table: supabase/payfx_orders.sql
SUPABASE_URL=
# Supabase > Project Settings > API keys > service_role (secret). Server only.
SUPABASE_SERVICE_ROLE_KEY=

# Shown on the website and invoices
BUSINESS_NAME=PayFX
BUSINESS_ADDRESS=12 Example Street, Lagos, Nigeria
BUSINESS_EMAIL=billing@example.com
BUSINESS_PHONE=+234 800 000 0000
# Optional: logo shown on the Flutterwave checkout page
BUSINESS_LOGO_URL=

# Flutterwave (Dashboard > Settings > API keys). Use FLWSECK_TEST-... for testing.
FLW_SECRET_KEY=
# Flutterwave webhook secret hash (Dashboard > Settings > Webhooks)
FLW_SECRET_HASH=

# Paystack (Dashboard > Settings > API Keys & Webhooks). Use sk_test_... for testing.
PAYSTACK_SECRET_KEY=

# Naira per US dollar for USD checkout (default 1365)
USD_RATE=

# Currencies each gateway account can take (comma-separated)
FLW_CURRENCIES=NGN,USD
PAYSTACK_CURRENCIES=NGN

# Password for /admin?token=...
ADMIN_TOKEN=
